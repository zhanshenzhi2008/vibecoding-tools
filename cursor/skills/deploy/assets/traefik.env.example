# =====================================================================
# Traefik 环境变量模板
# 复制为同目录 .env 后填写真实值
# 部署位置：与 Traefik compose 同级（服务器上一般是 /opt/docker/.env）
# 安全：chmod 600 .env ；不要提交 git
# =====================================================================

# 基础域名（不含 traefik. / portainer. 前缀）
# Dashboard 会拼成 traefik.${BASE_DOMAIN}，Portainer 会拼成 portainer.${BASE_DOMAIN}
BASE_DOMAIN=example.duckdns.org

# Traefik Dashboard Basic Auth（先不加可保持注释；compose 里对应 labels 也先注释）
# 生成命令：
#   htpasswd -nbB admin 'your-password'
# 把输出里的 $ 改成 $$ 再贴到下面（compose 会把单个 $ 当变量吃掉）
# 多人用逗号拼接：admin:$$hash1,alice:$$hash2
# 例：命令输出 admin:$2y$05$xxxx  →  写成 admin:$$2y$$05$$xxxx
# TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$change_me_to_htpasswd_hash
