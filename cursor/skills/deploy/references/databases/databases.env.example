# =====================================================================
# 通用数据库环境变量模板
# 复制为 .env 后填写真实值
# 部署位置：/opt/databases/.env
# 安全：chmod 600 /opt/databases/.env
# =====================================================================

# ─── PostgreSQL ───────────────────────────────────────────────
# 用户名（默认 postgres）
POSTGRES_USER=postgres
# 密码（必填，至少 16 位随机字符串）
POSTGRES_PASSWORD={{DB_PASSWORD}}
# 数据库名（默认同 PROJECT_NAME，可多项目共用同一实例时各自独立 DB）
POSTGRES_DB={{PROJECT_NAME}}

# ─── Redis ───────────────────────────────────────────────────
# 最大内存（默认 256mb）
REDIS_MAXMEMORY=256mb
# Redis 密码（如需认证，注释掉则无密码）
# REDIS_PASSWORD={{REDIS_PASSWORD}}

# ─── 备注 ───────────────────────────────────────────────────
# PostgreSQL 连接示例（应用侧）：
#   postgresql://postgres:{{DB_PASSWORD}}@db-postgres:5432/{{PROJECT_NAME}}
# Redis 连接示例：
#   redis://{{REDIS_PASSWORD:+:$REDIS_PASSWORD@}}db-redis:6379/0
#
# 键隔离：所有项目共用 db0，用前缀 {项目}:{模块}:{名字}
#   例：cogniforge:modelcfg:rev ；不要 SELECT 1/2
#
# 网络：{{DB_NETWORK}}（external，应用容器通过 --network {{DB_NETWORK}} 连接）
# 首次部署：docker network inspect {{DB_NETWORK}} || docker network create {{DB_NETWORK}}
