## MySQL 脚本编写规范

### 1. 新增字段

```sql
-- 日期 + 简短说明
ALTER TABLE `llm_agent`.`表名`
    ADD COLUMN `column_name` varchar(255) NULL COMMENT '字段说明' AFTER `上一个字段名`;
```

### 2. 修改字段

```sql
-- 日期 + 简短说明
ALTER TABLE `llm_agent`.`表名`
    MODIFY COLUMN `column_name` varchar(255) NULL COMMENT '修改后的说明' AFTER `上一个字段名`;
```

### 3. 新增表

```sql
-- 日期 + 简短说明
CREATE TABLE `llm_agent`.`表名` (
    `id` bigint NOT NULL,
    `name` varchar(255) NULL COMMENT '字段说明',
    PRIMARY KEY (`id`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_0900_ai_ci COMMENT='表说明';
```

### 4. 新增索引

```sql
-- 日期 + 简短说明
ALTER TABLE `llm_agent`.`表名`
    ADD INDEX `idx_xxx` (`column_name`);
```

### 5. 唯一索引

```sql
-- 日期 + 简短说明
ALTER TABLE `llm_agent`.`表名`
    ADD UNIQUE INDEX `uk_xxx` (`column1`, `column2`);
```

### 6. 新增数据

```sql
-- 日期 + 简短说明
INSERT INTO `llm_agent`.`sys_system_config` (`id`, `type`, `config_key`, `description`, `value`, `env_flag`)
VALUES (xxx, 'type', 'key', '说明', 'value', b'0');
```

### 7. 新增 meta_table_column 记录

```sql
-- 日期 + 简短说明
INSERT INTO `llm_agent`.`meta_table_column` 
(`id`, `table_id`, `column_name`, `column_type`, `column_comment`, `nullable`, `column_default`, `max_length`, `dimension`, `vector_type`, `is_graph`, `is_index`, `index_type`, `display_length`, `display_order`, `create_time`, `update_time`) 
VALUES (xxx, xxx, 'column_name', 'varchar', '字段说明', b'1', NULL, 255, NULL, NULL, 0, NULL, 0, 50, 10, '2026-05-28 18:00:00', '2026-05-28 18:00:00');
```

