{
  "name": "db-tools",
  "tools": [
    {
      "name": "switch_env",
      "description": "Switch database environment (local/dev/prod)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "env": {
            "type": "string",
            "description": "Environment name: local, dev, uat, or prod",
            "enum": ["local", "dev", "uat", "prod"]
          }
        },
        "required": ["env"]
      }
    },
    {
      "name": "list_envs",
      "description": "List available environments",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "current_env",
      "description": "Show current environment configuration",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "query",
      "description": "Execute SQL query on MySQL database",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sql": {
            "type": "string",
            "description": "SQL query to execute"
          },
          "params": {
            "type": "array",
            "description": "Optional query parameters"
          }
        },
        "required": ["sql"]
      }
    },
    {
      "name": "list_tables",
      "description": "List all tables in MySQL database",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "describe_table",
      "description": "Show table structure in MySQL",
      "inputSchema": {
        "type": "object",
        "properties": {
          "table": {
            "type": "string",
            "description": "Table name to describe"
          }
        },
        "required": ["table"]
      }
    },
    {
      "name": "query_mongodb",
      "description": "Execute query on MongoDB database",
      "inputSchema": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "description": "MongoDB collection name"
          },
          "filter": {
            "type": "object",
            "description": "Query filter (JSON object)"
          },
          "projection": {
            "type": "object",
            "description": "Fields to return"
          },
          "limit": {
            "type": "integer",
            "description": "Max documents (default: 100)"
          }
        },
        "required": ["collection"]
      }
    },
    {
      "name": "list_collections",
      "description": "List all collections in MongoDB",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    }
  ]
}
